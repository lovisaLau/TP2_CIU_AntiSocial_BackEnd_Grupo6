# Puerto de la API
PORT=3000

# Comentarios con más de esta cantidad de meses no se muestran al consultar un post
COMMENT_MAX_MONTHS=6

# Dialecto de base de datos: sqlite, mysql, mariadb, postgres, mssql
# (hay que instalar el driver correspondiente, por ejemplo: npm install mysql2)
DB_DIALECT=sqlite

# SQLite: se usa solo cuando DB_DIALECT=sqlite
DB_STORAGE=./src/data/antisocial.db

# Motores cliente/servidor (no hacen falta para SQLite)
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=antisocial
DB_USER=
DB_PASSWORD=

# true para ver las consultas SQL en consola
DB_LOGGING=false

#Bonus: tamaño maximo (en MB) de las imágenes que se suben al servidor
UPLOAD_MAX_MB=5